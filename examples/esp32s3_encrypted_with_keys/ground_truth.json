{
  "device": "esp32s3_encrypted_with_keys",
  "description": "ESP32-S3 with AES-XTS flash encryption and NVS encryption (key in the flash-encrypted nvs_keys partition); Wi-Fi credentials are only visible with the key.",
  "chip": "esp32s3",
  "flash_size": 4194304,
  "merge_tool": "internal",
  "baselines": [],
  "must_fire": [
    "NVS.WIFI_CREDENTIALS",
    "SEC.FLASH_ENCRYPTION_LIKELY"
  ],
  "must_not_fire": [
    "CORE.PRESENT",
    "FS.SUSPICIOUS_FILE",
    "IMG.CHECKSUM_BAD",
    "IMG.NO_APP_DESC",
    "IMG.SHA256_BAD",
    "IMG.SIGNATURE_INVALID",
    "IMG.SLOT_DIVERGENCE",
    "IMG.UNKNOWN_BUILD",
    "NVS.DELETED_SECRET",
    "OTA.INVALID_ACTIVE",
    "OTA.PENDING_VERIFY",
    "OTA.ROLLBACK_OR_DOWNGRADE",
    "PARSE.ANOMALY",
    "PT.MD5_MISMATCH",
    "PT.OUT_OF_BOUNDS",
    "PT.OVERLAP",
    "SEC.API_KEY",
    "SEC.CERT",
    "SEC.HARDCODED_CREDENTIAL",
    "SEC.MQTT_BROKER",
    "SEC.NO_FLASH_ENCRYPTION",
    "SEC.NO_SECURE_BOOT",
    "SEC.PRIVATE_KEY",
    "SEC.URL"
  ],
  "dont_care": [],
  "flash_key": "keys/flash_key.bin"
}
