{
  "device": "esp32_encrypted_esp32_scheme",
  "description": "Original ESP32 flash encryption (tweaked AES, FLASH_CRYPT_CONFIG 0xF); an AWS key in the encrypted ota_1 is only visible with the key.",
  "chip": "esp32",
  "flash_size": 4194304,
  "merge_tool": "internal",
  "baselines": [],
  "must_fire": [
    "SEC.API_KEY",
    "SEC.FLASH_ENCRYPTION_LIKELY"
  ],
  "must_not_fire": [
    "CORE.PRESENT",
    "FS.SUSPICIOUS_FILE",
    "IMG.CHECKSUM_BAD",
    "IMG.NO_APP_DESC",
    "IMG.SHA256_BAD",
    "IMG.SIGNATURE_INVALID",
    "IMG.SLOT_DIVERGENCE",
    "IMG.UNKNOWN_BUILD",
    "NVS.DELETED_SECRET",
    "NVS.WIFI_CREDENTIALS",
    "OTA.INVALID_ACTIVE",
    "OTA.PENDING_VERIFY",
    "OTA.ROLLBACK_OR_DOWNGRADE",
    "PARSE.ANOMALY",
    "PT.MD5_MISMATCH",
    "PT.OUT_OF_BOUNDS",
    "PT.OVERLAP",
    "SEC.CERT",
    "SEC.HARDCODED_CREDENTIAL",
    "SEC.MQTT_BROKER",
    "SEC.NO_FLASH_ENCRYPTION",
    "SEC.PRIVATE_KEY",
    "SEC.URL"
  ],
  "dont_care": [
    "SEC.NO_SECURE_BOOT"
  ],
  "flash_key": "keys/flash_key.bin",
  "flash_crypt_conf": 15
}
